# ── FreeCryptoAPI ─────────────────────────────────────────────────────────────
# Ключ из панели https://freecryptoapi.com/panel/
# Если ключа нет — сервис поднимается в демо-режиме (синтетические данные).
FCA_API_KEY=
FCA_BASE_URL=https://api.freecryptoapi.com/v1
# Принудительный демо-режим даже при наличии ключа: 1 / 0
FCA_DEMO=0

# Экономия кредитов: TTL кэша в секундах
CACHE_TTL_QUOTES=300
CACHE_TTL_OHLC=3600
CACHE_TTL_FG=1800
CACHE_TTL_LIST=86400
# Сколько дней истории тянуть на спарклайн (getOHLC = 1 кредит за свечу)
SPARK_DAYS=14
# Дорогие эндпоинты (10 и 100 кредитов за запрос) — по умолчанию выключены
ENABLE_TECHNICAL=0
ENABLE_NEWS=0

# ── Ollama (локальная LLM) ────────────────────────────────────────────────────
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-r1:latest
OLLAMA_TIMEOUT=300
OLLAMA_NUM_CTX=8192
# TTL кэша разборов LLM
CACHE_TTL_ANALYSIS=3600

# ── Backend ───────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=5310
DB_PATH=data/zerno.sqlite3
DEFAULT_WATCHLIST=BTC,ETH,SOL,TON,ARB,LINK
# Общий секрет: с ним бот получает доступ к чужим (tg:*) спискам
BOT_API_TOKEN=change-me

# ── Telegram-бот ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
API_BASE=http://127.0.0.1:5310
# Пустое поле = дайджест доступен всем; иначе список chat_id через запятую
TELEGRAM_ALLOWED_CHATS=
